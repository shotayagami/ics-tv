# icstv-yt-members-encoder (exposure_policy #27 メンバーミラー P の VAAPI サイドカー) 環境の例。
# 本番はチャンネルごとに /etc/icstv/yt-members-encoder-<slug>.env (mode 600) を置く
# (icstv-yt-members-encoder@<slug>.service が EnvironmentFile=/etc/icstv/yt-members-encoder-%i.env で読む)。
# このファイルは ch1 の例。実値 (YT_MEMBERS_INGEST_URL のキー) はコミットしない。
#
# ** GPU 容量実測 (docs/site-only-broadcast.md §5-1) 前にこのユニットを start しないこと。**

# ★per-channel: casparcg.config の「メンバーミラー P」channel の UDP 出力ポート (ch1 メンバーミラー = 5007)。
UDP_PORT=5007

# ★per-channel: YouTube Studio で事前に手動作成した永続 members-only ライブ配信 (docs §2) の
# RTMP ingest URL + stream key。番組窓ごとの可視性制御は agent 側の MirrorController (route/filler 切替)
# が行うため、この ingest 自体は常時 1 本で再接続しない。
YT_MEMBERS_INGEST_URL=rtmp://a.rtmp.youtube.com/live2/__REPLACE_WITH_YT_MEMBERS_STREAM_KEY__

# 本線 encoder.env.example の 720p (native top rung) と同じビットレートを既定に揃える。
VBITRATE=4500k
VBUFSIZE=9000k
# GOP: 2秒分 (720p60 → 120)。
GOP=120
