# icstv-encoder (VAAPI サイドカー) 環境の例。
# 本番はチャンネルごとに /etc/icstv/encoder-<slug>.env (mode 600) を置く
# (icstv-encoder@<slug>.service が EnvironmentFile=/etc/icstv/encoder-%i.env で読む)。
# このファイルは ch1 の例。実値 (CF_INGEST_URL のキー) はコミットしない。
# 複数チャンネルでは「★per-channel」項目をチャンネルごとに変える: UDP_PORT / ICSTV_CHANNEL_SLUG / CF_INGEST_URL。

# ★per-channel: CasparCG channel N の UDP 出力ポート (= 5004 + (N-1)。ch1=5004 / ch2=5005 / ch3=5006)。
# casparcg.config の <channel> 宣言順と一致させること。
UDP_PORT=5004

# ★per-channel: Channel.slug。ローカル MediaMTX への HLS path (rtmp://127.0.0.1:1935/hls/<slug>) に使う。
ICSTV_CHANNEL_SLUG=ch1

# ★per-channel: YouTube ingest URL + 永続 stream key を連結したもの。変数名は CF_INGEST_URL のままだが
# 実際の宛先は Cloudflare Live Input ではなく **YouTube ingest**（tee の1本目。docs/casparcg.md §6.4）。
# Cloudflare Live Input は本線 egress 経路には無く、studio の手動操作 (server/core/admin_views.py) と
# fanclub simulcast (server/fanclub/tasks.py) 用にのみ残る別経路。変数のリネームはノード env の互換を
# 壊すため行わない (実値の出所は Channel.youtube_ingest_url / youtube_stream_key。server/youtube/api.py
# の create_persistent_stream が liveStreams.insert で作成する)。
# 例: rtmp://a.rtmp.youtube.com/live2/<YOUTUBE_STREAM_KEY>
# exposure_policy (#27) の YTミラー導入後にこのチャンネルをカットオーバーする場合、この値自体は
# 変えず (YTミラー encoder 側の env へ同じ値を移設するだけ)、tee から YouTube leg を外すのは
# systemd drop-in で行う (deploy/playout-node/systemd/icstv-encoder@ch1.service.d.example/ 参照)。
CF_INGEST_URL=rtmp://a.rtmp.youtube.com/live2/__REPLACE_WITH_YOUTUBE_STREAM_KEY__

# --- 720p (native top rung): flv leg(YouTube/MediaMTX) と HLS ladder 最上段で共用するビットレート ---
# CasparCG channel は 720p6000 (720p60) なので native 上限は 720p。1080p は upscale になるため作らない。
# 注: 本番 ch1 の実値はこの例と異なる (VBITRATE=6500k/VBUFSIZE=13000k。2026-06-21 の
# videoIngestionStarved 対症のまま。docs/runbook-yt-cdn-recreate.md)。ノードの
# /etc/icstv/encoder-<slug>.env が実値の正。
VBITRATE=4500k
VBUFSIZE=9000k
# GOP: 2秒分 (720p60 → 120)。HLS セグメント 2s と揃える。
GOP=120

# --- 480p (HLS ladder 低帯域段): 回線が弱い環境向けのフォールバック ---
# 過負荷時は V480_BITRATE を下げる/360p 化する、または将来 HLS_480_ENABLE トグルで間引く。
V480_BITRATE=1800k
V480_BUFSIZE=3600k

# --- 144p (HLS ladder 超低帯域段, 256x144): 極端に細い回線/モバイル向け ---
# YouTube の 144p 相当。負荷は僅少。自動 ABR が 144p まで落ちられるよう、フロントの
# minAutoBitrate は音声のみ(96k)と 144p の間に置く (epg.html)。
V144_BITRATE=200k
V144_BUFSIZE=400k

# --- 音声のみ variant (HLS ladder): 映像が来ない環境でも音だけ届ける + データ節約 ---
# 64k〜96k。データ節約が目的なので低めで可。自動 ABR では選ばれず手動選択時のみ。
AUDIO_ONLY_BITRATE=96k
