# icstv-yt-mirror-encoder (exposure_policy #27 公開ミラー M の VAAPI サイドカー) 環境の例。
# 本番はチャンネルごとに /etc/icstv/yt-mirror-encoder-<slug>.env (mode 600) を置く
# (icstv-yt-mirror-encoder@<slug>.service が EnvironmentFile=/etc/icstv/yt-mirror-encoder-%i.env で読む)。
# このファイルは ch1 の例。実値 (YT_INGEST_URL のキー) はコミットしない。
#
# ** GPU 容量実測 (docs/site-only-broadcast.md §5-1) 前にこのユニットを start しないこと。**

# ★per-channel: casparcg.config の「公開ミラー M」channel の UDP 出力ポート
# (= 本線の 5004+(N-1) 採番を継続。ch1 公開ミラー = 5006)。
UDP_PORT=5006

# ★per-channel: 本線 encoder-<slug>.env の CF_INGEST_URL と同じ値 (本番カットオーバーで本線 tee から
# YouTube leg を外した分、この ingest 役を引き継ぐ)。Cloudflare Live Input の RTMP ingest URL + stream key。
YT_INGEST_URL=rtmp://live.cloudflare.com:1935/live/__REPLACE_WITH_CF_STREAM_KEY__

# 本線 encoder.env.example の 720p (native top rung) と同じビットレートを既定に揃える。
VBITRATE=4500k
VBUFSIZE=9000k
# GOP: 2秒分 (720p60 → 120)。
GOP=120
