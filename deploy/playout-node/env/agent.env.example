# icstv-agent 環境の例。env 契約は agent/icstv_agent/config.py。
# 本番はチャンネルごとに /etc/icstv/agent-<slug>.env (mode 600) を置く
# (icstv-agent@<slug>.service が EnvironmentFile=/etc/icstv/agent-%i.env で読む)。
# このファイルは ch1 の例。実値 (AGENT_TOKEN) はコミットしない。
# 複数チャンネルを同居させる際は、下記「★per-channel」項目を必ずチャンネルごとに変える:
#   ICSTV_CHANNEL_SLUG / ICSTV_AGENT_TOKEN / ICSTV_CASPAR_CHANNEL / ICSTV_QUEUE_DB / ICSTV_MEDIA_DIR
#
# 重要: systemd EnvironmentFile は「行内(値の後ろの)コメント」を除去しない。
# コメントは必ず値の行とは別の行 (# で始まる行) に書くこと。さもないと値にコメントが
# 混入し int() 変換等で agent が起動失敗する。

# control plane gRPC: icstv-grpc Service の固定 MetalLB IP (deploy/k8s/55-grpc.yaml で pin)。
# 下記は RFC 5737 TEST-NET-1 の例示値。自分のクラスタで pin した実際の IP に置き換えること。
ICSTV_SERVER_GRPC=192.0.2.91:50051

# ★per-channel: Channel.agent_token (Django admin / DB で生成・設定した値を貼る)
ICSTV_AGENT_TOKEN=__REPLACE_WITH_channel.agent_token__

# ★per-channel: Channel.slug
ICSTV_CHANNEL_SLUG=ch1

# ★per-channel: SQLite store-and-forward キュー (StateDirectory=icstv-agent → /var/lib/icstv-agent)。
# チャンネルごとに別ファイルにすること (共有するとキューが破損する)。
ICSTV_QUEUE_DB=/var/lib/icstv-agent/queue-ch1.db

# AMCP (同一ホストの CasparCG。port は全チャンネル共有)
ICSTV_CASPAR_HOST=127.0.0.1
ICSTV_CASPAR_PORT=5250
# ★per-channel: casparcg.config の宣言順 N 番目の <channel> (= AMCP channel N)
ICSTV_CASPAR_CHANNEL=1

# casparcg.config の video-mode と一致させること (720p6000 → 60 / 1080p3000 → 30)
ICSTV_FPS=60

# 緊急退避クリップ (media-path 配下に存在させる。install.sh が placeholder を生成)
ICSTV_SLATE_CLIP=slate/please_wait

# exposure_policy (#27、docs/site-only-broadcast.md §4.4) の YTミラー制御。このノードに
# icstv-yt-mirror-encoder@%i / icstv-yt-members-encoder@%i (casparcg.config の channel 3/4 相当)
# を導入していない場合は下の2行をコメントアウトしたまま (未設定=None) にする。MirrorController は
# mirror_channel が None の間は全メソッド no-op になり既存 1ch/2ch ノードを壊さない。
# ★per-channel (mirror 導入ノードのみ): casparcg.config の宣言順 N 番目 (公開ミラー M)
#ICSTV_YT_MIRROR_CASPAR_CHANNEL=3
# ★per-channel (mirror 導入ノードのみ): casparcg.config の宣言順 N 番目 (メンバーミラー P)
#ICSTV_YT_MEMBERS_CASPAR_CHANNEL=4
# 案内フィラー2種 (media-path 配下に存在させる)。placeholder を生成するのは install.sh
# (プロビジョニング専用・稼働ノードでは再実行しない) のみなので、#27 実装以前に構築済みの
# ノードには既定 clip の実体が存在しない (現行の送出ノードで 2026-09-02 実査: filler/ に default 系
# 0件)。exposure_policy 有効化前に media-path の filler/ へ実体を置くこと。
# manifest 未着時のノードローカル fallback (server の Channel.site_only_filler/members_filler
# manifest が優先。両方未設定ならこのクリップに固定フォールバック)。
ICSTV_SITE_ONLY_FILLER_CLIP=filler/site_only_default
ICSTV_MEMBERS_FILLER_CLIP=filler/members_default

ICSTV_PREROLL_SEC=5
ICSTV_HEARTBEAT_SEC=30

# フィラー↔番組の差し替えを黒フェード(dip to black)で繋ぐ片側のフェード長(ms)。
# フェードアウト(filler→黒)・フェードイン(番組→通常)とも同じ長さ。0 でハードカット(従来挙動)。
# 番組同士・CM のハードカット既定は維持し、フィラー境界のみに適用 (docs/casparcg.md §2.4)。
ICSTV_TRANSITION_MS=500

# feed monitor (生入力 publisher 監視。docs/operations.md O2/O6)。MediaMTX は同一ホスト。
ICSTV_MEDIAMTX_API=http://127.0.0.1:9997
ICSTV_FEED_POLL_SEC=1.0
# publisher 消失を 2 tick (=2s) 連続で feed 断とみなす
ICSTV_FEED_LOST_TICKS=2
# 復帰を 10 tick (=10s) 連続確認してから自動復帰
ICSTV_FEED_HYSTERESIS_TICKS=10
ICSTV_FEED_FLAP_WINDOW_SEC=600
# 窓内の自動復帰がこれを超えたらサスペンド
ICSTV_FEED_FLAP_MAX=3

# prefetch (R2 mezzanine → ローカル媒体フォルダ先読み + LRU 退避。overview 3.2)。
# ICSTV_MEDIA_DIR は CasparCG の media-path と一致させること (LOADBG は clip 名をここから解決)。
# 【共有・per-channel にしない】CasparCG の <media-path> は全チャンネル共通の単一フォルダのため、
# 同居する全 agent インスタンスで同じ値にする (別フォルダにすると他チャンネルの clip を CasparCG が
# 解決できず LOADBG 404 → slate 固着になる)。素材は asset 単位で content-addressed (clip 名一意) なので
# 共有して問題ない。queue.db のみインスタンス別にする。
ICSTV_MEDIA_DIR=/var/lib/icstv-agent/media
# 50 GiB。送出ノードの SSD 容量に合わせる
ICSTV_CACHE_MAX_BYTES=53687091200
# 4h 先までの素材を先読み
ICSTV_PREFETCH_AHEAD_SEC=14400
ICSTV_PREFETCH_POLL_SEC=60
# 1 周あたりの最大先読み件数
ICSTV_PREFETCH_LIMIT=128
# 「直近受信した event」も先読み対象に含める窓 (秒)。filler は just-in-time 発行で受信即
# executed になり未来候補から漏れるため、この窓で拾い直して次回の LOADBG に間に合わせる
ICSTV_PREFETCH_RECENT_SEC=900

# 出力 watchdog (agent 内蔵の層0。docs/casparcg.md §6.7)。本線 foreground を INFO で
# ポーリングし、黒 (producer=empty) / フレーム time 不変 (フリーズ) が連続 BAD_TICKS 回
# 続いたら 1 度だけ再 take する。スレート表示中 (意図的) と INFO 取得失敗 (判定不能) は skip。
ICSTV_WATCHDOG_POLL_SEC=3
ICSTV_WATCHDOG_BAD_TICKS=3

# 生放送録画 (record_live)。MediaMTX に録画させるローカルディレクトリと、送出ノードのディスク
# 逼迫時に録画を諦める閾値 (簡易ガード。本線送出には影響させない best-effort)。
ICSTV_RECORDING_DIR=/var/lib/icstv-agent/recordings
# 5 GiB
ICSTV_RECORDING_MIN_FREE_BYTES=5368709120
# アップロード失敗時の store-and-forward 再送周期
ICSTV_RECORDING_UPLOAD_POLL_SEC=60
