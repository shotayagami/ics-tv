# ICS-TV ライブ静止画 (公開トップ「いま放送中」) ingest 設定。共有 (全 ch 共通)。
# /etc/icstv/poster.env に置く。per-channel の slug/token は agent-<slug>.env から読む。
# 以下の IP (192.0.2.x, RFC 5737 TEST-NET-1) は例示。自分の k8s ノード IP に置き換えること。
#
# 経路: poster-grab (MediaMTX 現在フレーム) --POST--> {BASE}/internal/live-poster/<slug>/
#        ヘッダ  X-Agent-Token: Channel.agent_token (= agent と同一トークン)
# ingest ルートは管理ホスト (ROOT urlconf) のみに存在する (公開ホスト tv.* には無い = 視聴専用原則)。
# 送出ノードは LAN 上にあるため、LAN の HTTP ingress を BASE に、管理ホスト名を Host ヘッダに指定する
# (CF Access は edge のみ。LAN 直叩きは通る。agent の ICSTV_SERVER_GRPC と同じ到達網)。
# ingress-nginx は各 k8s ノードの hostPort:443 に居る → ノード IP を直接叩く (192.0.2.80=k8s のコントロールプレーンノード /
# 192.0.2.83=k8s のワーカーノード。どちらでも可)。icstv-web Ingress が studio.yagamin.net を web svc へ振る。
# HTTP:80 は 308 で HTTPS へ強制リダイレクトされるため必ず https://。IP 直叩き + Host のため
# 証明書 CN は一致せず、poster-grab.sh は -k で接続する (内部 LAN の信頼経路)。
# 検証済み: POST https://192.0.2.80/internal/live-poster/ch1/ (Host: studio.yagamin.net) →
#   誤トークンで 403 (= アプリ到達)。正トークンで 204。

# 管理ホストへ到達する HTTPS のベース URL (= k8s ノードの ingress hostPort:443)
ICSTV_POSTER_INGEST_BASE=https://192.0.2.80
# 管理ホスト名 (Host ヘッダ。settings.ICSTV_ADMIN_HOSTS のいずれか)
ICSTV_POSTER_HOST=studio.yagamin.net
# 取得/送信間隔 秒 (公開配信 max-age=10 と揃える)
ICSTV_POSTER_INTERVAL=10
# 出力幅 px (カード用。小さめで R2/転送を軽く。高さは偶数自動)
ICSTV_POSTER_WIDTH=640
# 取得元 (既定は MediaMTX のローカル RTMP。slug 展開済み値を直接書いてもよい)
# ICSTV_POSTER_SRC=rtmp://127.0.0.1:1935/hls/ch1
