<?xml version="1.0" encoding="utf-8"?>
<!--
  ICS-TV 送出ノード CasparCG 設定 (multi-ch, headless EGL on Intel UHD630 / VAAPI)。
  ** 2026-06-10 に実証用 LXC (Ubuntu 24.04 + CasparCG 2.5.0 PPA) で実証済みの構成 **

  マルチチャンネル: <channel> を宣言順に並べると AMCP channel 1,2,3,... になる。各 agent は
  ICSTV_CASPAR_CHANNEL=N で担当 channel を選び、icstv-encoder@<slug> が channel N の UDP 出力
  (5004 + (N-1)) を H.264 化する。1 CasparCG サーバ / 1 AMCP ポート(5250)を全 channel で共有し、
  UHD630 iGPU も共有する (容量はノードで要検証)。

  docs/casparcg.md §1.1 のレイヤ規約 (本線10/生退避11/バンパー20/Lバー30/速報40/提供50/スレート90) は
  agent (icstv_agent/amcp_planner.py) が AMCP で実現する。本 config は channel 宣言のみ。

  実証で判明した必須ポイント:
  - 起動 env: EGL_PLATFORM=surfaceless (これが無いと eglChooseConfig 失敗。device platform は不可)
              LC_ALL=C.UTF-8 LANG=C.UTF-8 (無いと locale エラーで abort)
              LIBVA_DRIVER_NAME=iHD
    → Intel UHD630 で「OpenGL 4.6 (Compatibility Profile) Mesa Intel」で初期化される。
    → これらは systemd unit (casparcg-server.service) の Environment で投入する。
  - CEF(HTML CG) は <enable-gpu>false>。true だと CEF の GPU サブプロセスが segfault (headless/session無し)。
  - 送出は localhost UDP(mpegts intra mpeg2video) のみ。実 H.264 エンコードは icstv-encoder が
    /dev/dri/renderD128 上の h264_vaapi で行う (CasparCG consumer は VAAPI 不可 = Issue #1300)。
  - 音声: CasparCG の audio mixer は 16ch(hexadecagonal)。mp2/aac は 2ch までのため consumer 側で
    -filter:a pan=stereo|c0=c0|c1=c1 で stereo にダウンミックスする (これが無いと consumer 初期化失敗)。
-->
<configuration>
  <log-level>info</log-level>

  <paths>
    <media-path>/opt/casparcg/media/</media-path>
    <log-path>/opt/casparcg/log/</log-path>
    <data-path>/opt/casparcg/data/</data-path>
    <template-path>/opt/casparcg/template/</template-path>
  </paths>

  <lock-clear-phrase>icstv</lock-clear-phrase>

  <!-- CEF (HTML テンプレ CG): GPU は無効 (headless で CEF GPU プロセスが落ちるため CPU 描画) -->
  <html>
    <enable-gpu>false</enable-gpu>
  </html>

  <channels>
    <!-- 2026-08-18: 実機 (送出ノード) を正として 1ch 構成に揃えた。
         以前ここには channel 2 (ICS-TV ch2) と、exposure_policy (#27) 用の
         channel 3 (YTミラー「公開M」) / channel 4 (同「メンバーP」) が宣言されていたが、
         送出ノードの CPU/GPU 負荷削減のため実機側で削除済みだった。宣言するだけで
         CasparCG は channel ごとに mixer と consumer (720p60 / mpeg2video 15M) を動かすため、
         未使用でもコストが乗る。リポジトリだけ 4ch のまま放置すると install.sh 再実行で
         残骸チャンネルが復活して後退するため、リポジトリ側を実機に合わせる。
         4ch 構成はサーバ増設時に再検討する (UHD630 は本線+ミラー2本で RCS ~90% の実績があり、
         3本同時は専用 GPU 増設が実質前提。docs/site-only-broadcast.md §5-1)。
         復活させる場合は video-mode を本線と一致させること (route producer が channel 合成のため
         モード不一致だと壊れる)。UDP は 5004 + (N-1) で採番する。 -->
    <!-- channel 1 = ICS-TV ch1 (ICSTV_CASPAR_CHANNEL=1, UDP 5004, icstv-encoder@ch1) -->
    <channel>
      <!-- 720p60 既定 (ICSTV_FPS=60 と一致)。1080p30 にするなら 1080p3000 + ICSTV_FPS=30 -->
      <video-mode>720p6000</video-mode>
      <consumers>
        <!-- 送出は localhost UDP(mpegts intra) のみ。HW エンコードは icstv-encoder が担う。
             -filter:a pan で 16ch→stereo にダウンミックス (mp2 が 2ch までのため必須)。 -->
        <ffmpeg>
          <path>udp://127.0.0.1:5004?pkt_size=1316</path>
          <args>-format mpegts -vcodec mpeg2video -b:v 15M -g 1 -bf 0 -pix_fmt yuv420p -filter:a pan=stereo|c0=c0|c1=c1 -acodec mp2 -b:a 192k -ar 48000</args>
        </ffmpeg>
      </consumers>
    </channel>
  </channels>

  <!-- AMCP listener (agent が 127.0.0.1:5250 へ接続)。CasparCG 2.5 で動作確認済み。 -->
  <controllers>
    <tcp>
      <port>5250</port>
      <protocol>AMCP</protocol>
    </tcp>
  </controllers>
</configuration>
