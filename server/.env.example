# ============================================================================
# ICS-TV server 環境変数の正本 (server/config/settings.py が読む全キーを網羅)。
# - ローカル: `cp server/.env.example server/.env` して実値を埋める
#   (~/.env への symlink は不可 — CONTRIBUTING.md「環境変数」参照)。
# - 本番実値: 導入者の配備基盤側が持つ (非機密は ConfigMap 相当、機密は Secret 相当に分けて配る)。
# - コメントアウトのキーは未設定で settings.py の既定値 (括弧内) が使われる。空値のまま
#   残しているキーは「未設定 = 当該機能が安全に無効」のもの。既定値の正本は settings.py。
# - 正規化/オフロードのチューニング系 (MEZZ_* 以外の FFMPEG_TIMEOUT / LOUDNORM_* /
#   NORMALIZE_OFFLOAD_* 等) は settings.py でなく server/medialib/*.py が直接 os.environ を
#   読む。キー一覧はそちらを正本とする。
# ============================================================================

# ---- 必須 (ローカル起動の最小セット) ----

# Django
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 外部 https オリジンからの POST を CSRF 許可 (本番は configmap で全ホスト列挙)
#DJANGO_CSRF_TRUSTED_ORIGINS=

# #3 機密フィールドの DB at-rest 暗号化鍵 (Fernet, urlsafe base64 32B)。空=平文 (dev のみ)。
# 生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ICSTV_FIELD_ENCRYPTION_KEY=

# 専用 PostgreSQL (他サービスと共有の PostgreSQL サーバとは別インスタンス)
# pragma: allowlist nextline secret
DATABASE_URL=postgres://icstv:icstv@localhost:5432/icstv

# Celery (Redis broker)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# WebSocket channel layer (redis db 2。既定 redis://localhost:6379/2)
#ICSTV_CHANNEL_REDIS_URL=
# broker visibility timeout 秒 (既定 25200 = 7h。長尺 encode より長く)
#CELERY_VISIBILITY_TIMEOUT=

# ---- ホスト種別 (HostUrlconfMiddleware) ----
# フル機能を許す管理ホスト (既定: localhost,127.0.0.1,testserver,icstv-web ほか)
#DJANGO_ADMIN_HOSTS=
# 🔴放送コンソール専用ホスト (既定: 空 (未設定で無効))
#DJANGO_OPS_HOSTS=
# クリエイターポータル専用ホスト (既定: 空 (未設定で無効))
#DJANGO_CREATOR_HOSTS=

# ---- Cloudflare R2 (S3 互換, 正規化素材の保管先) ----
R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=icstv-mezzanine
R2_REGION=auto

# ---- 正規化 (mezzanine) 仕様。要件「映像スペック確定」時に上書き ----
MEZZ_WIDTH=1920
MEZZ_HEIGHT=1080
MEZZ_FPS=60
MEZZ_VBITRATE=16M
MEZZ_ABITRATE=192k

# ---- Google OAuth (YouTube Data API write 用、Google Cloud Console で取得) ----
# 手順のまとまりは docs/youtube.md §0。scope=https://www.googleapis.com/auth/youtube.force-ssl
# redirect_uri は /admin-ui/oauth/callback/ (実 host で配信)
ICSTV_OAUTH_CLIENT_ID=
ICSTV_OAUTH_CLIENT_SECRET=

# ---- クリエイターポータル (#27。YouTube 用とは別の GCP OAuth クライアント) ----
# scope=openid+userinfo.email、redirect_uri は creator.* の /auth/google/callback/
ICSTV_CREATOR_OAUTH_CLIENT_ID=
ICSTV_CREATOR_OAUTH_CLIENT_SECRET=
# 招待リンクの絶対 URL 化 (既定 "" = リクエストホスト)
#ICSTV_CREATOR_BASE_URL=
# 招待の有効日数 (既定 14)
#ICSTV_CREATOR_INVITATION_TTL_DAYS=

# ---- Cloudflare Stream (Live Input/Output for ファンアウト → YouTube) ----
# Account ID は CF dashboard 右下、API Token は My Profile → API Tokens で
# Stream:Edit パーミッションを持つトークンを発行
ICSTV_CF_API_TOKEN=
ICSTV_CF_ACCOUNT_ID=

# ---- 公開面 / 送出 ----
# 公開サイトの絶対ベース URL (例 https://tv.example.com。空 = ローカル相対パス)
#ICSTV_PUBLIC_BASE_URL=
# 本線 HLS 署名 HMAC 鍵 (#27。edge Worker と共有。空 = SECRET_KEY へフォールバック)
#ICSTV_HLS_SIGNING_KEY=
# HLS トークン TTL 秒 (既定 3600)
#ICSTV_HLS_TOKEN_TTL_SEC=
# 生入力 (LiveSource) ingest URL 生成用の送出ノード内部 IP (例 192.0.2.10)。studio「生入力」画面が
# OBS へ渡す SRT/RTMP push URL を組み立てる際に使う。未設定は雛形プレースホルダ表示。
ICSTV_INGEST_NODE_HOST=
# 朝夕の左上時計の既定時間帯 (JSON。既定 [{"start":"04:30","end":"08:00"},{"start":"15:00","end":"19:00"}])
#ICSTV_CLOCK_WINDOWS=
# #6 CM 割付 constraint provider (dotted path。既定 sales.constraints.ContractConstraintProvider。空=均等ローテ)
#ICSTV_FILL_CONSTRAINT_PROVIDER=

# ---- 内部連携トークン (未設定 = 当該連携が無効。X-Internal-Token) ----
# 天気予報 icstv-weather → /api/v1/internal/weather-import
#WEATHER_IMPORT_TOKEN=
# 地震速報 icstv-earthquake → /api/v1/internal/breaking-telop
#EARTHQUAKE_FIRE_TOKEN=
# 納品 icstv-delivery → /api/v1/internal/delivery-asset・/delivery-refs (読み seam とトークン共用)
#DELIVERY_REGISTER_TOKEN=
# バックオフィス icstv-backoffice → /api/v1/internal/backoffice/*
#BACKOFFICE_READ_TOKEN=
# ギフト/投げ銭 追加側 (独立サービス) → /api/v1/internal/addon/*
#ADDON_GIFT_TOKEN=

# ---- 通知 / メール ----
# 通知 webhook (Discord/Slack 互換。未設定なら通知 DB 記録のみで配送はスキップ) — docs/operations.md O3
ICSTV_NOTIFY_WEBHOOK_URL=
# メール (会員のメール検証/2FA)。既定 backend=console (stdout 出力)。本番は任意の SMTP 事業者を env で差す
#DJANGO_EMAIL_BACKEND=
#DJANGO_EMAIL_HOST=
#DJANGO_EMAIL_PORT=
#DJANGO_EMAIL_HOST_USER=
#DJANGO_EMAIL_HOST_PASSWORD=
#DJANGO_EMAIL_USE_TLS=
# 送信元 (既定は空)。配送する backend (smtp 等) では必須で、空のままだと起動時に停止する
#DJANGO_DEFAULT_FROM_EMAIL=

# ---- 会員認証のパラメータ (既定は settings.py の括弧内の値) ----
#ICSTV_MEMBER_CODE_TTL=                # コード有効秒 (600)
#ICSTV_MEMBER_CODE_MAX_ATTEMPTS=       # (5)
#ICSTV_MEMBER_CODE_SEND_COOLDOWN=      # 再送間隔秒 (60)
#ICSTV_MEMBER_CODE_SEND_MAX_PER_HOUR=  # (8)
#ICSTV_LOGIN_FAIL_MAX=                 # email 単位 (5)
#ICSTV_LOGIN_IP_FAIL_MAX=              # IP 単位 (20)
#ICSTV_LOGIN_FAIL_WINDOW=              # 秒 (900)
#ICSTV_TOTP_FAIL_MAX=                  # (5)
#ICSTV_TOTP_IP_FAIL_MAX=               # (20)
#ICSTV_TOTP_FAIL_WINDOW=               # 秒 (900)
#ICSTV_CLIENT_IP_HEADER=               # 実IPを読む META キー (HTTP_X_FORWARDED_FOR)

# ---- Stripe (課金。空 = 課金無効。本番も現状未投入 = 課金準備中) ----
#STRIPE_SECRET_KEY=
#STRIPE_PUBLISHABLE_KEY=
# Webhook の署名秘密。視聴者サブスクとファンクラブは別のエンドポイントで、秘密も別 (docs/operations.md
# の「Stripe Webhook」)。空のエンドポイントは 503 を返す。
#STRIPE_WEBHOOK_SECRET=
#STRIPE_FC_WEBHOOK_SECRET=
#STRIPE_CONNECT_APPLICATION_FEE_PERCENT=   # (10.0)

# ---- 運用系 ----
# ログレベル (既定 INFO)
#LOG_LEVEL=
# アプリ版数はビルド時に CI が焼き込む。手動設定不要 (未ビルド環境は "dev")
#ICSTV_VERSION=
# 本番 fail-closed ガード (#sec M-5/M-6/I-4)。configmap が true を設定。ローカルは既定 false
#ICSTV_REQUIRE_SECRETS=
